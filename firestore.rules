rules_version = '2';
// ===== E-Cíclica • regras de segurança do Firestore =====
// Cole este arquivo inteiro em: Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // liberação de upload: o usuário grava a senha em uploadGrants/{uid};
    // a regra só aceita se o SHA-256 da senha bater com este hash.
    // Para trocar a senha: gere o novo hash (README) e substitua aqui E em assets/js/store-local.js.
    function senhaOk(s) { return hashing.sha256(s).toBase64() == 'mvFbM25qlhmShTffMLLmojdlafz51+dz7M7eZWBlKaA='; }
    function liberado() {
      return signedIn() && exists(/databases/$(database)/documents/uploadGrants/$(request.auth.uid))
        && get(/databases/$(database)/documents/uploadGrants/$(request.auth.uid)).data.at > request.time - duration.value(12, 'h');
    }

    match /uploadGrants/{uid} {
      allow read: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.chave is string && senhaOk(request.resource.data.chave)
        && request.resource.data.at == request.time;
    }

    // cadastro: nome + matrícula (todos iguais)
    match /users/{mat} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.matricula == mat
        && request.resource.data.nome is string && request.resource.data.nome.size() > 1;
      allow update: if signedIn() && request.resource.data.matricula == resource.data.matricula;
      allow delete: if liberado();
    }

    match /config/app {
      allow read: if signedIn();
      allow write: if liberado();
    }

    match /cycles/{cid} {
      allow read: if signedIn();
      allow write: if liberado();
      match /rows/{g} { allow read: if signedIn(); allow write: if liberado(); }
      match /file/{n} { allow read: if signedIn(); allow write: if liberado(); }
      // preenchimentos: qualquer pessoa cadastrada preenche; apagar o ciclo exige liberação
      match /fills/{g} {
        allow read, create, update: if signedIn();
        allow delete: if liberado();
      }
    }
  }
}
